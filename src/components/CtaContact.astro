---
import { SITE } from '../data/site';
---

<section class="section contact" id="contact">
  <div class="container container--narrow contact__inner reveal">
    <p class="sec-head__eyebrow contact__eyebrow">Contact</p>
    <h2 class="contact__title">まずは、お気軽にご相談ください</h2>
    <p class="contact__lead">
      見学・無料体験のご予約、プランのご相談など、<br class="pc-only" />
      お好きな方法でお問い合わせいただけます。
    </p>

    <div class="contact__grid">
      <a href={SITE.telHref} class="contact__item card">
        <span class="contact__label">お電話で</span>
        <span class="contact__value">{SITE.tel}</span>
        <span class="contact__note">{SITE.staffHours}</span>
      </a>
      <a href={SITE.line} target="_blank" rel="noopener" class="contact__item card contact__item--line">
        <span class="contact__label">LINEで</span>
        <span class="contact__value">友だち追加して相談</span>
        <span class="contact__note">栄養・生活習慣の相談も無料</span>
      </a>
      <a href={SITE.contactForm} target="_blank" rel="noopener" class="contact__item card">
        <span class="contact__label">フォームで</span>
        <span class="contact__value">お問い合わせフォーム</span>
        <span class="contact__note">24時間受付・順次ご返信</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--ink-2);
    border-top: 1px solid var(--line);
  }

  .contact__inner {
    text-align: center;
  }

  .contact__eyebrow {
    justify-content: center;
  }

  .contact__eyebrow::after {
    content: '';
    width: 2.5rem;
    height: 1px;
    background: var(--gold);
  }

  .contact__title {
    font-size: var(--text-2xl);
    margin-bottom: 1.5rem;
  }

  .contact__lead {
    color: var(--paper-dim);
    margin-bottom: 3rem;
  }

  .contact__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    text-align: left;
  }

  .contact__item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.75rem 1.5rem;
    background: var(--ink);
    transition: border-color 0.3s, transform 0.3s var(--ease-out);
  }

  .contact__item:hover {
    border-color: var(--gold);
    transform: translateY(-4px);
  }

  .contact__label {
    font-family: var(--font-latin);
    font-size: var(--text-xs);
    letter-spacing: 0.25em;
    color: var(--gold);
  }

  .contact__value {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    letter-spacing: 0.06em;
  }

  .contact__note {
    font-size: var(--text-xs);
    color: var(--paper-faint);
  }

  .pc-only {
    display: none;
  }

  @media (min-width: 768px) {
    .pc-only {
      display: inline;
    }
  }

  @media (max-width: 767px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
