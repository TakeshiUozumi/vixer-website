---
import { NAV, SITE } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <p class="footer__logo">
        <span class="footer__logo-main">ViXer</span>
        <span class="footer__logo-sub">Life Design</span>
      </p>
      <p class="footer__address">
        {SITE.address}<br />
        TEL {SITE.tel}／FAX {SITE.fax}<br />
        {SITE.hours}<br />
        {SITE.staffHours}
      </p>
      <div class="footer__sns">
        <a href={SITE.instagram} target="_blank" rel="noopener">Instagram</a>
        <a href={SITE.line} target="_blank" rel="noopener">LINE</a>
      </div>
    </div>

    <nav class="footer__nav" aria-label="フッターナビゲーション">
      <ul>
        <li><a href="/">トップ</a></li>
        {NAV.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href="/radio/">ラジオアーカイブ</a></li>
      </ul>
    </nav>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <div class="footer__legal">
        <a href="/privacy/">プライバシーポリシー</a>
        <span aria-hidden="true">／</span>
        <a href="/legal/">特定商取引法に基づく表記</a>
      </div>
      <p class="footer__copy">© {year} Life Design ViXer All Rights Reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: var(--ink-2);
    margin-top: auto;
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
    justify-content: space-between;
    padding-block: 4rem;
  }

  .footer__logo {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .footer__logo-main {
    font-family: var(--font-latin);
    font-size: 1.75rem;
    letter-spacing: 0.12em;
  }

  .footer__logo-sub {
    font-family: var(--font-latin);
    font-size: 0.7rem;
    letter-spacing: 0.4em;
    color: var(--gold);
    text-transform: uppercase;
  }

  .footer__address {
    font-size: var(--text-sm);
    color: var(--paper-dim);
  }

  .footer__sns {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .footer__sns a {
    font-family: var(--font-latin);
    font-size: var(--text-sm);
    letter-spacing: 0.15em;
    color: var(--gold);
    border-bottom: 1px solid var(--gold-dim);
    padding-bottom: 2px;
  }

  .footer__sns a:hover {
    color: var(--gold-bright);
  }

  .footer__nav ul {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 0.75rem 2.5rem;
  }

  .footer__nav a {
    font-size: var(--text-sm);
    color: var(--paper-dim);
  }

  .footer__nav a:hover {
    color: var(--gold);
  }

  .footer__bottom {
    border-top: 1px solid var(--line);
    padding-block: 1.5rem;
  }

  .footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
  }

  .footer__legal {
    font-size: var(--text-xs);
    color: var(--paper-faint);
    display: flex;
    gap: 0.5rem;
  }

  .footer__legal a:hover {
    color: var(--gold);
  }

  .footer__copy {
    font-family: var(--font-latin);
    font-size: var(--text-xs);
    color: var(--paper-faint);
    letter-spacing: 0.1em;
  }
</style>
