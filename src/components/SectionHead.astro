---
interface Props {
  eyebrow: string;
  title: string;
  center?: boolean;
}
const { eyebrow, title, center = false } = Astro.props;
---

<div class:list={['sec-head', 'reveal', { 'sec-head--center': center }]}>
  <p class="sec-head__eyebrow">{eyebrow}</p>
  <h2 class="sec-head__title">{title}</h2>
</div>
