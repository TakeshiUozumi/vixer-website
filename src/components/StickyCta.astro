<div class="sticky-cta is-hidden" id="sticky-cta">
  <a href="/#trial" class="btn-cta sticky-cta__btn">30日間無料体験はこちら</a>
</div>

<style>
  .sticky-cta {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 90;
    transition: transform 0.45s var(--ease-out), opacity 0.45s;
  }

  /* 左右いっぱいのバー型CTA */
  .sticky-cta__btn {
    width: 100%;
    font-size: clamp(0.8rem, 3.4vw, 1.1875rem);
    letter-spacing: clamp(0.06em, 0.5vw, 0.16em);
    white-space: nowrap;
    padding: 1.1rem 0.5rem calc(1.1rem + env(safe-area-inset-bottom));
    border-left: 0;
    border-right: 0;
    border-bottom: 0;
  }

  .sticky-cta.is-hidden {
    transform: translateY(110%);
    opacity: 0;
  }
</style>

<script>
  const bar = document.getElementById('sticky-cta');
  // 体験セクション・ヒーローが見えている間は隠す（同じCTAの重複表示を避ける）
  const watched = [
    document.getElementById('trial'),
    document.querySelector('.hero'),
    document.querySelector('.cta-trial'),
  ].filter(Boolean) as Element[];

  if (bar) {
    const overlapsViewport = (el: Element) => {
      const r = el.getBoundingClientRect();
      const overlap = Math.min(r.bottom, window.innerHeight) - Math.max(r.top, 0);
      return overlap > window.innerHeight * 0.25;
    };

    const update = () => {
      bar.classList.toggle('is-hidden', watched.some(overlapsViewport));
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }
</script>
