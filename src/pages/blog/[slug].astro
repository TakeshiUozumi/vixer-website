---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaContact from '../../components/CtaContact.astro';
import { CATEGORIES } from '../../data/categories';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data.date;
const dateStr = `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<Base title={post.data.title} description={post.data.description} ogImage={post.data.image}>
  <article class="post">
    <header class="post__head">
      <div class="container container--narrow">
        <p class="post__meta">
          <a href={`/blog/category/${post.data.category}/`} class="post__cat">{CATEGORIES[post.data.category]}</a>
          <time datetime={d.toISOString().slice(0, 10)}>{dateStr}</time>
        </p>
        <h1 class="post__title">{post.data.title}</h1>
      </div>
    </header>

    {post.data.image && (
      <div class="container container--narrow">
        <img class="post__hero" src={post.data.image} alt="" width="900" height="600" />
      </div>
    )}

    <div class="container container--narrow post__body">
      <Content />
    </div>

    <footer class="container container--narrow post__foot">
      <a href="/blog/" class="btn">記事一覧へ戻る</a>
    </footer>
  </article>

  <CtaContact />
</Base>

<style>
  .post__head {
    padding-top: clamp(8rem, 6rem + 6vw, 11rem);
    padding-bottom: 2.5rem;
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
    font-family: var(--font-latin);
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    color: var(--paper-faint);
  }

  .post__cat {
    background: var(--gold);
    color: var(--ink);
    font-family: var(--font-body);
    padding: 0.2rem 0.9rem;
    letter-spacing: 0.1em;
  }

  .post__title {
    font-size: var(--text-2xl);
  }

  .post__hero {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 1px solid var(--line);
  }

  .post__body {
    padding-block: 3rem;
  }

  .post__body :global(h2) {
    font-size: var(--text-xl);
    margin: 2.5em 0 1em;
    padding-left: 1rem;
    border-left: 2px solid var(--gold);
  }

  .post__body :global(h3) {
    font-size: var(--text-lg);
    margin: 2em 0 0.75em;
    color: var(--gold-bright);
  }

  .post__body :global(p) {
    margin-bottom: 1.5em;
    color: var(--paper-dim);
  }

  .post__body :global(ol),
  .post__body :global(ul) {
    margin: 0 0 1.5em;
    padding-left: 1.5em;
    color: var(--paper-dim);
  }

  .post__body :global(ol) {
    list-style: decimal;
  }

  .post__body :global(ul) {
    list-style: disc;
  }

  .post__body :global(li) {
    margin-bottom: 0.5em;
  }

  .post__body :global(strong) {
    color: var(--paper);
  }

  .post__foot {
    padding-bottom: var(--space-section);
    text-align: center;
  }
</style>
