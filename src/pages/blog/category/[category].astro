---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import BlogCard from '../../../components/BlogCard.astro';
import CtaTrial from '../../../components/CtaTrial.astro';
import { CATEGORIES, type CategoryId } from '../../../data/categories';

export async function getStaticPaths() {
  return Object.keys(CATEGORIES).map((category) => ({ params: { category } }));
}

const { category } = Astro.params as { category: CategoryId };
const label = CATEGORIES[category];

const posts = (await getCollection('blog', (p) => p.data.category === category)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base
  title={`${label}の記事一覧｜健康コラム`}
  description={`Life Design ViXer の健康コラムから「${label}」に関する記事の一覧です。`}
>
  <PageHero eyebrow="Health Column" title={`「${label}」の記事`} />

  <section class="section">
    <div class="container">
      <nav class="cats reveal" aria-label="カテゴリ">
        <a href="/blog/" class="cats__link">すべて</a>
        {Object.entries(CATEGORIES).map(([id, l]) => (
          <a
            href={`/blog/category/${id}/`}
            class:list={['cats__link', { 'is-active': id === category }]}
            aria-current={id === category ? 'page' : undefined}
          >
            {l}
          </a>
        ))}
      </nav>

      {posts.length > 0 ? (
        <div class="grid">
          {posts.map((post) => (
            <div class="reveal">
              <BlogCard
                slug={post.id}
                title={post.data.title}
                category={post.data.category}
                date={post.data.date}
                image={post.data.image}
              />
            </div>
          ))}
        </div>
      ) : (
        <p class="empty">このカテゴリの記事はまだありません。<a href="/blog/">すべての記事を見る</a></p>
      )}
    </div>
  </section>

  <CtaTrial />
</Base>

<style>
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 3rem;
  }

  .cats__link {
    font-size: var(--text-sm);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.45rem 1.4rem;
    color: var(--paper-dim);
    transition: border-color 0.3s, color 0.3s;
  }

  .cats__link:hover {
    border-color: var(--gold);
    color: var(--paper);
  }

  .cats__link.is-active {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--ink);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .empty {
    color: var(--paper-dim);
  }

  .empty a {
    color: var(--gold);
    text-decoration: underline;
  }

  @media (max-width: 1023px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
