<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.blog__tab');
  const cells = document.querySelectorAll<HTMLElement>('.blog__cell');

  const apply = (cat: string) => {
    let shown = 0;
    cells.forEach((cell) => {
      const match = cat === 'all' || cell.dataset.category === cat;
      const visible = match && shown < 3;
      cell.hidden = !visible;
      if (visible) shown++;
    });
  };

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.toggle('is-active', t === tab);
        t.setAttribute('aria-selected', String(t === tab));
      });
      apply(tab.dataset.cat ?? 'all');
    });
  });

  apply('all');
</script>
