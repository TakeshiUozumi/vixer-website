---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../data/site';

// 「（要記入）」の項目は公開前に正式な情報へ差し替えてください。
const ITEMS = [
  { label: '販売業者', value: 'Life Design ViXer（要記入：正式な事業者名）' },
  { label: '運営責任者', value: '（要記入）' },
  { label: '所在地', value: SITE.address },
  { label: '電話番号', value: `${SITE.tel}（受付：平日 10:00–21:00／土日祝 10:00–18:30）` },
  { label: '販売価格', value: '各プラン・チケットのページに税込価格を表示しています。' },
  { label: '商品代金以外の必要料金', value: '入会金 5,500円（税込）※キャンペーンにより無料となる場合があります。' },
  { label: 'お支払い方法', value: 'クレジットカード決済のみ' },
  { label: '支払時期', value: '月会費は毎月所定日にクレジットカードより引き落とし。チケットはご購入時。' },
  { label: 'サービスの提供時期', value: 'ご入会手続き完了後、即日ご利用いただけます。' },
  { label: '返品・キャンセル', value: 'サービスの性質上、ご購入後の返金は原則お受けしておりません。退会は引き落とし日までに店頭またはWebにてお手続きください。' },
];
---

<Base title="特定商取引法に基づく表記" description="Life Design ViXer の特定商取引法に基づく表記です。">
  <PageHero eyebrow="Legal" title="特定商取引法に基づく表記" />

  <section class="section">
    <div class="container container--narrow">
      <dl class="legal reveal">
        {ITEMS.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>

<style>
  .legal div {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 1.5rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--text-sm);
  }

  .legal div:first-child {
    border-top: 1px solid var(--line);
  }

  .legal dt {
    color: var(--gold);
    font-family: var(--font-display);
  }

  .legal dd {
    margin: 0;
    color: var(--paper-dim);
  }

  @media (max-width: 640px) {
    .legal div {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
