---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaTrial from '../components/CtaTrial.astro';
import { SITE } from '../data/site';

const TICKETS = [
  { count: '1回分', price: '5,500', per: '5,500' },
  { count: '8回分', price: '40,000', per: '5,000', popular: false },
  { count: '16回分', price: '72,000', per: '4,500', popular: true },
  { count: '24回分', price: '96,000', per: '4,000', popular: false },
];
---

<Base
  title="料金プラン"
  description="Life Design ViXer の料金プラン。フルタイム会員 月額9,980円、DAY会員 月額6,980円。パーソナルトレーニング・ヘッドスパに使えるチケットもご用意。入会金無料キャンペーン実施中。"
>
  <PageHero
    eyebrow="Price"
    title="料金プラン"
    lead="月額プランとパーソナルチケットの組み合わせで、あなたに合った通い方を。すべて税込価格です。"
  />

  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Monthly" title="月額プラン" />
      <div class="plans">
        <div class="plan card reveal">
          <h3 class="plan__name">フルタイム会員</h3>
          <p class="plan__price"><span>9,980</span>円<small>／月</small></p>
          <p class="plan__desc">24時間365日、いつでも利用可能。仕事帰りも早朝も、あなたのペースで。</p>
        </div>
        <div class="plan card reveal">
          <h3 class="plan__name">DAY会員</h3>
          <p class="plan__price"><span>6,980</span>円<small>／月</small></p>
          <p class="plan__desc">平日5:00〜17:00の利用。日中に通える方におすすめのお得なプランです。</p>
        </div>
      </div>

      <div class="admission reveal">
        <p class="admission__label">入会金</p>
        <p class="admission__price">
          <s>5,500円</s>
          <strong>今なら無料</strong>
        </p>
        <p class="admission__note">※入会金無料キャンペーン実施中。時期により内容が変わる場合があります。</p>
      </div>
    </div>
  </section>

  <section class="section tickets-sec">
    <div class="container">
      <SectionHead eyebrow="Personal Ticket" title="パーソナルチケット" />
      <p class="tickets-lead reveal">
        パーソナルトレーニング（50分）・ヘッドスパ（50分）にご利用いただけます。<br />
        予約制：平日 10:00〜21:00／土日祝 10:00〜18:30
      </p>

      <div class="services">
        <figure class="service card reveal">
          <img src="/images/personal-training.jpg" alt="パーソナルトレーニングの様子" width="900" height="600" loading="lazy" />
          <figcaption>
            <p class="service__en">Personal Training</p>
            <h3 class="service__title">パーソナルトレーニング（50分）</h3>
            <p class="service__body">
              有資格トレーナーがマンツーマンで指導。姿勢や身体の状態を見極め、目的に合わせたメニューを組み立てます。フォームの習得から本格的なボディメイクまで、初心者の方も安心です。
            </p>
          </figcaption>
        </figure>
        <figure class="service card reveal">
          <img src="/images/headspa.jpg" alt="ヘッドスパの施術" width="900" height="600" loading="lazy" />
          <figcaption>
            <p class="service__en">Head Spa</p>
            <h3 class="service__title">ヘッドスパ（50分）</h3>
            <p class="service__body">
              トレーニング後のご褒美に、頭皮からほぐす50分のリラクゼーション。日々の疲れやストレスを解きほぐし、心と身体の両方を整えます。鍛える日と癒やす日、どちらもViXerで。
            </p>
          </figcaption>
        </figure>
      </div>

      <div class="tickets">
        {TICKETS.map((t) => (
          <div class:list={['ticket', 'card', 'reveal', { 'ticket--popular': t.popular }]}>
            {t.popular && <span class="ticket__badge">人気No.1</span>}
            <p class="ticket__count">{t.count}</p>
            <p class="ticket__price"><span>{t.price}</span>円</p>
            <p class="ticket__per">1回あたり {t.per}円</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section options-sec">
    <div class="container container--narrow">
      <SectionHead eyebrow="Options" title="オプション" />
      <dl class="options reveal">
        <div>
          <img src="/images/hydrogen-water.jpg" alt="" width="80" height="80" loading="lazy" class="options__img" />
          <dt>水素水</dt>
          <dd>1,100円／月</dd>
        </div>
        <div>
          <img src="/images/locker.jpg" alt="" width="80" height="80" loading="lazy" class="options__img" />
          <dt>契約ロッカー</dt>
          <dd>550円／月</dd>
        </div>
      </dl>
      <p class="options__note reveal">
        ※お支払いはクレジットカードのみの対応となります。<br />
        ※LINEでの食事・生活習慣サポートは無料でご利用いただけます。
      </p>
      <div class="options__cta reveal">
        <a href="/#trial" class="btn-cta">30日間無料体験はこちら</a>
      </div>
    </div>
  </section>

  <CtaTrial />
</Base>

<style>
  .plans {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .plan {
    padding: 2.5rem 2rem;
    text-align: center;
  }

  .plan__name {
    font-size: var(--text-xl);
    margin-bottom: 1.25rem;
  }

  .plan__price {
    font-family: var(--font-display);
    color: var(--gold);
    margin-bottom: 1.25rem;
  }

  .plan__price span {
    font-family: var(--font-latin);
    font-size: 3rem;
    line-height: 1;
  }

  .plan__price small {
    color: var(--paper-faint);
    font-size: var(--text-sm);
  }

  .plan__desc {
    font-size: var(--text-sm);
    color: var(--paper-dim);
  }

  .admission {
    margin-top: 2.5rem;
    border: 1px solid var(--gold-dim);
    padding: 2rem;
    text-align: center;
    background:
      radial-gradient(ellipse 60% 100% at 50% 0%, rgba(184, 160, 106, 0.08), transparent),
      var(--ink-2);
  }

  .admission__label {
    font-family: var(--font-display);
    letter-spacing: 0.2em;
    color: var(--gold);
    margin-bottom: 0.5rem;
  }

  .admission__price {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .admission__price s {
    color: var(--paper-faint);
  }

  .admission__price strong {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--paper);
  }

  .admission__note {
    font-size: var(--text-xs);
    color: var(--paper-faint);
  }

  .tickets-sec {
    background: var(--ink-2);
    border-block: 1px solid var(--line);
  }

  .tickets-lead {
    color: var(--paper-dim);
    font-size: var(--text-sm);
    margin-bottom: 2.5rem;
  }

  .tickets {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .ticket {
    position: relative;
    background: var(--ink);
    padding: 2.25rem 1.25rem;
    text-align: center;
  }

  .ticket--popular {
    border-color: var(--gold);
  }

  .ticket__badge {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    background: var(--gold);
    color: var(--ink);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    padding: 0.2rem 1rem;
  }

  .ticket__count {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--gold);
    margin-bottom: 1rem;
  }

  .ticket__price span {
    font-family: var(--font-latin);
    font-size: 1.9rem;
  }

  .ticket__per {
    margin-top: 0.75rem;
    font-size: var(--text-xs);
    color: var(--paper-faint);
  }

  .services {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .service {
    margin: 0;
    background: var(--ink);
    overflow: hidden;
  }

  .service img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .service figcaption {
    padding: 1.75rem 1.5rem;
  }

  .service__en {
    font-family: var(--font-latin);
    font-size: var(--text-xs);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.5rem;
  }

  .service__title {
    font-size: var(--text-lg);
    margin-bottom: 0.75rem;
  }

  .service__body {
    font-size: var(--text-sm);
    color: var(--paper-dim);
  }

  .options div {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
  }

  .options__img {
    width: 64px;
    height: 64px;
    object-fit: cover;
    border: 1px solid var(--line);
    flex-shrink: 0;
  }


  .options div:first-child {
    border-top: 1px solid var(--line);
  }

  .options dd {
    margin: 0 0 0 auto;
    color: var(--gold);
  }

  .options__note {
    margin-top: 1.5rem;
    font-size: var(--text-xs);
    color: var(--paper-faint);
  }

  .options__cta {
    margin-top: 3rem;
    text-align: center;
  }

  @media (max-width: 767px) {
    .plans,
    .services {
      grid-template-columns: 1fr;
    }
    .tickets {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
